+//! Genuine pre-extension runtime fixture exporter. Run only in an isolated offline container.
+use super::*;
+use redb::ReadableTable;
+
+fn copy_tree(source: &Path, target: &Path) {
+    std::fs::create_dir(target).unwrap();
+    for entry in std::fs::read_dir(source).unwrap() {
+        let entry = entry.unwrap();
+        let to = target.join(entry.file_name());
+        assert!(!entry.file_type().unwrap().is_symlink());
+        if entry.file_type().unwrap().is_dir() {
+            copy_tree(&entry.path(), &to);
+        } else {
+            std::fs::copy(entry.path(), to).unwrap();
+        }
+    }
+}
+fn receipt_bytes(path: &Path, p: &PurgeProgress) -> Vec<u8> {
+    let (_copy, db) = validation::inspect_database(&path.join("meta.db")).unwrap();
+    let read = db.begin_read().unwrap();
+    read.open_table(control::RECEIPTS).unwrap().get(control::scoped_key(
+        p.store_id, MutationScope::Namespace(p.namespace_id), p.start_receipt.operation_id.as_bytes()
+    ).as_slice()).unwrap().unwrap().value().to_vec()
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "explicit genuine BEFORE fixture export"]
+async fn export_native_context_before_four_combinations() {
+    struct Clock;
+    impl crate::time::Clock for Clock { fn now_millis(&self) -> i64 { 2000 } }
+    let output = PathBuf::from(std::env::var("RECALLD_CONTEXT_BEFORE_OUTPUT").unwrap());
+    assert!(!output.exists());
+    std::fs::create_dir(&output).unwrap();
+    for force in [false, true] {
+        for cas in [false, true] {
+            let case = output.join(format!("force-{force}-cas-{cas}"));
+            std::fs::create_dir(&case).unwrap();
+            let (path, id, _) = fixture(&case);
+            let mut s = open(&path);
+            let mut catalog = ctx(&s, id, "empty-namespace");
+            catalog.scope = MutationScope::Catalog;
+            let made = s.engine.create_native_namespace(&catalog, &native_catalog::NativeNamespaceInput {
+                name: "empty-purge".into(), embedding_dim: Some(4), embedding_profile_id: None,
+                initial_stability: None, desired_retention: None, decay_rate_multiplier: None,
+            }, &crate::embedding::runtime::tests::profile(), &NativePolicyInputs::default(), &Clock, None).unwrap();
+            let control::MutationOutcome::NativeNamespaceCreated { transition } = made.outcome else { panic!() };
+            let mut context = ctx(&s, transition.namespace_id, "old-purge");
+            if !cas { context.expected_generation = None; }
+            let before = s.engine.control_state().unwrap().committed_generation;
+            let start = s.engine.begin_namespace_purge(&context, force).unwrap();
+            assert_eq!(start.start_receipt.committed_generation, before.next().unwrap());
+            assert_eq!(start.sequence, 0);
+            assert_eq!(start.start_receipt, start.last_receipt);
+            assert_eq!(start.stage, PurgeStage::Deleting);
+            drop(s);
+            copy_tree(&path, &case.join("started"));
+            let raw = receipt_bytes(&path, &start);
+            let stored = control::validate_receipt(&raw).unwrap();
+            let mut matches = 0;
+            for f in [false, true] {
+                for expected in [None, Some(before)] {
+                    let c = MutationContext { expected_generation: expected, ..context.clone() };
+                    if control::request_hash(&c, "namespace_purge_v2", &[&[u8::from(f)]]) == stored.request_hash { matches += 1; }
+                }
+            }
+            assert_eq!(matches, 1);
+            let value: serde_json::Value = serde_json::from_slice(&raw).unwrap();
+            assert!(value["receipt"]["outcome"]["transition"].get("request").is_none());
+            std::fs::write(case.join("original-start-receipt.json"), &raw).unwrap();
+            std::fs::write(case.join("case.json"), serde_json::to_vec_pretty(&serde_json::json!({
+                "force": force, "cas": cas, "previousGeneration": before, "progress": start
+            })).unwrap()).unwrap();
+            // Genuine existing recovery completes the preserved start, without a new start receipt.
+            let mut s = open(&path);
+            let replay = s.engine.begin_namespace_purge(&context, force).unwrap();
+            assert!(replay.start_receipt.replayed);
+            assert_eq!(replay.stage, PurgeStage::Complete);
+            drop(s);
+            assert_eq!(receipt_bytes(&path, &start), raw);
+            let stream = case.join("logical.jsonl");
+            let imported = case.join("forked");
+            assert_eq!(logical_export::export_store(&path, &stream).unwrap(), logical_export::import_store(&stream, &imported).unwrap());
+            let archive = crate::backup::run_backup(&crate::config::RecalldConfig::default(), &case.join("backup.zip"), Some(&imported), false).await.unwrap();
+            crate::backup::restore_from_backup(crate::backup::RestoreOptions {
+                backup_path: archive, data_dir: imported.clone(), force: true, no_stop_daemon: true, historical: false,
+            }).await.unwrap();
+            let fork = open(&imported);
+            assert_ne!(fork.engine.control_state().unwrap().store_id, start.store_id);
+            drop(fork);
+            assert_eq!(receipt_bytes(&imported, &start), raw);
+            println!("BEFORE force={force} cas={cas} previous={before:?} matches={matches} source-and-fork-receipt-bytes-preserved");
+        }
+    }
+}
