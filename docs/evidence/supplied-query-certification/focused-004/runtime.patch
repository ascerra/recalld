+async fn certify_similar_namespace(source: &std::path::Path, ns: NamespaceId) -> tempfile::TempDir {
+    use crate::storage::{control::MutationScope, vector_certification::{ReembedVectors, reembed_fresh}};
+    let snapshot = crate::storage::offline_snapshot::OfflineSnapshot::open(source).unwrap();
+    let at = snapshot.control().generation_ref();
+    let namespace = snapshot.namespaces().iter().find(|n| n.id == ns).unwrap();
+    let crate::model::schema::EmbeddingBinding::Bound { descriptor, profile_id, .. } =
+        &namespace.schema.as_ref().unwrap().embedding_binding else { panic!("Bound fixture") };
+    let provider = SimilarRecipe(descriptor.clone());
+    let request = ReembedVectors {
+        source: at, namespace_id: ns, namespace_name: namespace.name.clone(), profile_id: profile_id.clone(),
+        context: MutationContext { store_id: Some(at.store_id), expected_generation: Some(at.generation),
+            scope: MutationScope::Namespace(ns), contract_version:1, idempotency_key:Some(format!("similar-fixture-remedy-{}",ns.get())) },
+    };
+    drop(snapshot);
+    let target = tempfile::tempdir().unwrap();
+    std::fs::remove_dir(target.path()).unwrap();
+    reembed_fresh(source, target.path(), &request, &provider).await.unwrap();
+    target
+}
