+#[cfg(test)]
+mod catalog_owner_probe {
+    use super::*;
+    use serde_json::json;
+
+    fn capture(system: &crate::Recalld) -> serde_json::Value {
+        let engine = system.storage().read().unwrap();
+        let meta = engine.meta_store();
+        let state = meta.publication_state().unwrap();
+        let tx = meta.db.begin_read().unwrap();
+        let receipts = tx.open_table(control::RECEIPTS).unwrap().iter().unwrap()
+            .map(|row| {
+                let (_, value) = row.unwrap();
+                serde_json::to_value(control::validate_receipt(value.value()).unwrap().receipt).unwrap()
+            }).collect::<Vec<_>>();
+        json!({"canonical": state.canonical, "applied": state.applied,
+            "coherent": state.matches_canonical(), "receipts": receipts})
+    }
+
+    #[tokio::test]
+    async fn catalog_owner_create_then_false_recall_probe() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut config = crate::config::RecalldConfig::default();
+        config.storage.data_dir = dir.path().to_string_lossy().into_owned();
+        config.embedding.provider = crate::config::EmbeddingProvider::Passthrough;
+        config.embedding.dimensions = 4;
+        config.decay.disable_sweep = true;
+        let system = crate::Recalld::new(config).await.unwrap();
+        let bridge = crate::mcp::bridge_adapters::direct_bridge(&system, "default".into());
+        let before = capture(&system);
+        println!("CATALOG_PROBE_BEFORE={}", before);
+        assert_eq!(before["coherent"], true, "actual startup must publish its views");
+        let created = crate::mcp::tools::dispatch_tool(&bridge, "create_namespace",
+            json!({"name":"foreign","embeddingDim":4})).await;
+        println!("CATALOG_PROBE_CREATE={}", serde_json::to_string(&created).unwrap());
+        assert_ne!(created.is_error, Some(true));
+        let after_create = capture(&system);
+        println!("CATALOG_PROBE_AFTER_CREATE={}", after_create);
+        assert_eq!(after_create["receipts"].as_array().unwrap().len(),
+            before["receipts"].as_array().unwrap().len()+1);
+        let response = crate::mcp::tools::dispatch_tool(&bridge, "recall_memories",
+            json!({"query":"amber","namespace":"default","recordAccess":false,"depth":0,"limit":3})).await;
+        println!("CATALOG_PROBE_RECALL={}", serde_json::to_string(&response).unwrap());
+        let after_read = capture(&system);
+        println!("CATALOG_PROBE_AFTER_READ={}", after_read);
+        assert_eq!(after_read, after_create, "false read changes no captured canonical/publication state");
+        assert_ne!(response.is_error, Some(true), "empty namespace creation must not break read-only recall");
+    }
+}
