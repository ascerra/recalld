+        let tx = db.begin_write().unwrap();
+        if kind == "omit-row" {
+            let mut table = tx.open_table(crate::storage::metadata::META_TABLE).unwrap();
+            let id = table.iter().unwrap().next().unwrap().unwrap().0.value().to_vec();
+            table.remove(id.as_slice()).unwrap();
+        } else if kind == "omit-receipt" {
+            let mut table = tx.open_table(control::RECEIPTS).unwrap();
+            let key = table.iter().unwrap().find_map(|row| {
+                let (key, value) = row.unwrap();
+                matches!(control::validate_receipt(value.value()).unwrap().receipt.outcome, control::MutationOutcome::VectorsReembedded { .. }).then(|| key.value().to_vec())
+            }).unwrap();
+            table.remove(key.as_slice()).unwrap();
+        } else {
+            let mut table = tx.open_table(crate::storage::metadata::NAMESPACE_TABLE).unwrap();
+            let mut ns: NamespaceConfig = control::decode(table.get(request.namespace_id.get()).unwrap().unwrap().value()).unwrap();
+            let schema = ns.schema.as_mut().unwrap();
+            if kind == "strip-feature" { schema.required_features.clear(); }
+            else { schema.vector_certification.as_mut().unwrap().origin.store_id = Uuid::new_v4(); }
+            table.insert(request.namespace_id.get(), control::encode(&ns).unwrap().as_slice()).unwrap();
+        }
+        tx.commit().unwrap(); drop(db);
+        let bytes = std::fs::read(copy.join("meta.db")).unwrap();
+        let result = OfflineSnapshot::open(&copy);
+        let error = match result { Ok(_) => panic!("accepted {kind}"), Err(error) => error };
+        if kind == "omit-row" { assert!(error.to_string().contains("cutover reverse inventory count"), "{error:?}"); }
+        assert_eq!(std::fs::read(copy.join("meta.db")).unwrap(), bytes, "source changed for {kind}");
+        assert!(RedbStorageEngine::open_native(&copy).is_err());
+        assert_eq!(std::fs::read(copy.join("meta.db")).unwrap(), bytes, "live preflight changed {kind}");
