+#[tokio::test]
+async fn vector_certification_publication_failure_and_unknown_ack_replay_exact_receipt() {
+    for point in ["certification_before_commit", "certification_after_commit", "certification_published", "certification_commit_unknown"] {
+        let root = tempfile::tempdir().unwrap();
+        let (source, request, provider) = fixture(root.path());
+        let before = file_hashes(&source);
+        let target = root.path().join("result");
+        crate::storage::catalog::FAILURE.with(|f| f.set(Some(point)));
+        let error = reembed_fresh(&source, &target, &request, &provider).await.unwrap_err();
+        crate::storage::catalog::FAILURE.with(|f| f.set(None));
+        assert_eq!(file_hashes(&source), before);
+        let stage = root.path().join("result.recalld-vector-certification");
+        if point == "certification_before_commit" {
+            assert!(!target.exists() && !stage.exists());
+            assert!(!matches!(error, StorageError::CommittedMutation { .. } | StorageError::CommitOutcomeUnknown { .. }));
+            continue;
+        }
+        let retained = OfflineSnapshot::open(if target.exists() { &target } else { &stage }).unwrap();
+        let retained_receipt = receipts(&retained).values().find_map(|bytes| {
+            let receipt = control::validate_receipt(bytes).unwrap().receipt;
+            matches!(receipt.outcome, control::MutationOutcome::VectorsReembedded { .. }).then_some(receipt)
+        }).unwrap();
+        drop(retained);
+        match error {
+            StorageError::CommittedMutation { receipt, .. } => assert_eq!(*receipt, retained_receipt),
+            StorageError::CommitOutcomeUnknown { operation_id, .. } => {
+                assert_eq!(point, "certification_commit_unknown");
+                assert_eq!(operation_id, retained_receipt.operation_id);
+            }
+            other => panic!("lost known cutover state: {other:?}"),
+        }
+        let no_provider = Provider { profile: provider.profile, texts: Mutex::new(vec![]), fail: true };
+        let replay = reembed_fresh(&root.path().join("source-no-longer-needed"), &target, &request, &no_provider).await.unwrap();
+        let mut expected = retained_receipt;
+        expected.replayed = true;
+        assert_eq!(replay, expected);
+        assert!(no_provider.texts.lock().unwrap().is_empty());
+        assert!(!stage.exists());
+        let mut changed = request.clone();
+        changed.context.contract_version = 2;
+        assert!(matches!(reembed_fresh(&source, &target, &changed, &no_provider).await, Err(StorageError::IdempotencyConflict)));
+    }
+}
