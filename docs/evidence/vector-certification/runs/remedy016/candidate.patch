+use super::*;
+use crate::storage::{RedbStorageEngine, logical_export, offline_snapshot::OfflineSnapshot};
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use redb::ReadableTable;
+
+pub(crate) struct Provider {
+    profile: crate::model::schema::EmbeddingProfile,
+    texts: Mutex<Vec<String>>,
+    fail: bool,
+}
+#[async_trait::async_trait]
+impl crate::embedding::EmbeddingProvider for Provider {
+    fn profile(&self) -> Option<crate::model::schema::EmbeddingProfile> { Some(self.profile.clone()) }
+    fn dimensions(&self) -> usize { self.profile.dimension as usize }
+    fn model_name(&self) -> &str { &self.profile.model_id }
+    async fn embed(&self, text: &str) -> Result<Vec<f32>, crate::embedding::EmbeddingError> {
+        self.texts.lock().unwrap().push(text.into());
+        if self.fail { return Err(crate::embedding::EmbeddingError::Unavailable("test provider failure".into())); }
+        Ok(vec![0., 1., 0., 0.])
+    }
