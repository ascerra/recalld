+    drop(snapshot);
+    let replay_provider = Provider { fail: true, ..provider };
+    let replay = reembed_fresh(&source, &destination, &request, &replay_provider).await.unwrap();
+    assert!(replay.replayed);
+    assert_eq!(replay.operation_id, receipt.operation_id);
+    assert_eq!(*replay_provider.texts.lock().unwrap(), documents);
