+pub(crate) fn fixture(root: &Path) -> (PathBuf, ReembedVectors, Provider) {
+    let export = root.join("genuine-before.jsonl");
+    std::fs::write(&export, include_bytes!("../metadata/native_records/fixtures/document-recipe-legacy.jsonl")).unwrap();
+    let path = root.join("old");
+    logical_export::import_store(&export, &path).unwrap();
+    let history: serde_json::Value = serde_json::from_slice(include_bytes!("../metadata/native_records/fixtures/document-recipe-legacy-receipts.json")).unwrap();
+    let profile: crate::model::schema::EmbeddingProfile = serde_json::from_value(history["profile"].clone()).unwrap();
+    let ns: NamespaceId = serde_json::from_value(history["namespaceId"].clone()).unwrap();
+    let snapshot = OfflineSnapshot::open(&path).unwrap();
+    let source = snapshot.control().generation_ref();
+    let namespace = snapshot.namespaces().iter().find(|n| n.id == ns).unwrap();
+    let request = ReembedVectors { source, namespace_id: ns, namespace_name: namespace.name.clone(), profile_id: profile.profile_id().unwrap(),
+        context: MutationContext { store_id: Some(source.store_id), expected_generation: Some(source.generation), scope: MutationScope::Namespace(ns), contract_version: 1, idempotency_key: Some("explicit-reembedding".into()) } };
+    (path, request, Provider { profile, texts: Mutex::new(vec![]), fail: false })
+}
+fn file_hashes(path: &Path) -> BTreeMap<PathBuf, [u8; 32]> {
+    crate::storage::validation::canonical_files(path).unwrap().into_iter().map(|p| {
+        (p.strip_prefix(path).unwrap().to_owned(), hash_bytes(&std::fs::read(p).unwrap()))
+    }).collect()
+}
+fn receipts(snapshot: &OfflineSnapshot) -> BTreeMap<Vec<u8>, Vec<u8>> {
+    snapshot.metadata.begin_read().unwrap().open_table(control::RECEIPTS).unwrap().iter().unwrap()
+        .map(|row| { let (key, value) = row.unwrap(); (key.value().to_vec(), value.value().to_vec()) }).collect()
+}
+fn limits() -> crate::storage::canonical_vector_snapshot::SnapshotLimits {
+    crate::storage::canonical_vector_snapshot::SnapshotLimits { max_records: 1000, max_bytes: 1024 * 1024 }
+}
