+#[tokio::test]
+async fn vector_certification_owned_commits_and_queries_do_not_rescan_history() {
+    use crate::storage::native_lifecycle::{NativeLifecycleSession, NativePolicyInputs};
+    use crate::storage::StorageEngine as _;
+    use std::sync::Arc;
+    let root = tempfile::tempdir().unwrap();
+    let (source, request, provider) = fixture(root.path());
+    let destination = root.path().join("owned");
+    reembed_fresh(&source, &destination, &request, &provider).await.unwrap();
+    crate::test_support::explicitly_adopt_inherited_policy(&destination, request.namespace_id, 1., 100_000_000);
+    let mut session = NativeLifecycleSession::open(&destination, NativePolicyInputs::default(), Arc::new(crate::time::ManualClock::new(100_000_000))).unwrap();
+    control::take_validation_work();
+    for _ in 0..3 { session.engine.canonical_vector_snapshot(&request.namespace_name, None, limits()).unwrap(); }
+    assert_eq!(control::take_validation_work(), control::ValidationWork::default());
+    let input = fresh_input();
+    let receipt = session.insert_generated(&fresh_context(&request, "fresh-generated"), scope(&request), &input, &provider).await.unwrap();
+    let work = control::take_validation_work();
+    assert_eq!(work.full_validations, 0, "{work:?}");
+    assert_eq!(work.certification_scans, 0, "{work:?}");
+    let first_insert_work = work;
+    let current = session.engine.canonical_vector_snapshot(&request.namespace_name, None, limits()).unwrap();
+    assert_eq!(current.binding.at.generation, receipt.committed_generation);
+    let ns = session.engine.get_namespace(request.namespace_id).unwrap().unwrap();
+    let noop = session.update_policy(&fresh_context(&request, "keyed-policy-noop"), scope(&request), &crate::storage::catalog::NamespacePolicy::from(&ns)).unwrap().unwrap();
+    assert_eq!(noop.committed_generation, receipt.committed_generation.next().unwrap());
+    assert_eq!(session.engine.canonical_vector_snapshot(&request.namespace_name, None, limits()).unwrap().binding.at.generation, noop.committed_generation);
+    // Grow real retained history, then compare identical generated-ID work.
+    // The existing explicit supplied-UUID lifetime scan is a separate path; no
+    // certification optimization bypasses that check or claims it disappeared.
+    for index in 0..12 {
+        session.update_policy(&fresh_context(&request, &format!("history-noop-{index}")), scope(&request), &crate::storage::catalog::NamespacePolicy::from(&ns)).unwrap().unwrap();
+    }
+    control::take_validation_work();
+    session.insert_generated(&fresh_context(&request, "second-generated"), scope(&request), &fresh_input(), &provider).await.unwrap();
+    assert_eq!(control::take_validation_work(), first_insert_work);
+    let batch_context = MutationContext { scope: MutationScope::Catalog, contract_version: 2, ..fresh_context(&request, "batch-reservation") };
+    let error = crate::storage::batch::BatchError::new("INVALID_INPUT");
+    let batch = session.metadata().reserve_batch(&batch_context, crate::storage::batch::BatchKind::Insert,
+        &[crate::storage::batch::BatchItemPlan::NativeInsert { request_hash: [17; 32], namespace: request.namespace_name.clone(), input: fresh_input() }]).unwrap();
+    assert_eq!(session.engine.canonical_vector_snapshot(&request.namespace_name, None, limits()).unwrap().binding.at.generation, batch.reservation_receipt.committed_generation);
+    let completed = session.metadata().finalize_batch_error(&batch.child(0).unwrap(), error).unwrap();
+    assert!(matches!(&completed.items[0].state, crate::storage::batch::BatchItemState::Error { error } if error.code == "INVALID_INPUT"));
+    let at = session.engine.control_state().unwrap().generation_ref();
+    assert_eq!(session.engine.canonical_vector_snapshot(&request.namespace_name, None, limits()).unwrap().binding.at, at);
+    let work = control::take_validation_work();
+    assert_eq!(work.full_validations, 0, "{work:?}");
+    assert_eq!(work.certification_scans, 0, "{work:?}");
+    drop(session);
+    OfflineSnapshot::open(&destination).unwrap();
+}
