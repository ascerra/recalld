+++ b/src/storage/metadata/certification.rs
@@ -0,0 +1,148 @@
+//! The existing metadata publication lock owns this validation state. It grants
+//! no work admission, derived readiness, or independent generation authority.
+use super::*;
+use crate::storage::control::GenerationRef;
+use crate::storage::vector_certification::VectorCertification;
+use std::collections::BTreeMap;
+
+pub(super) struct OwnedVectorValidation {
+    at: GenerationRef,
+    schema: crate::storage::canonical_schema::CanonicalSchemaState,
+    namespaces: BTreeMap<u32, VectorCertification>,
+}
+pub(super) struct VectorValidationCommit {
+    before: GenerationRef,
+    after: GenerationRef,
+    created: Option<(u32, VectorCertification)>,
+}
+impl OwnedVectorValidation {
+    pub(super) fn require_at(&self, at: GenerationRef) -> Result<(), StorageError> {
+        if self.at != at {
+            return Err(StorageError::RecoveryRequired("owned vector validation does not match canonical generation".into()));
+        }
+        Ok(())
+    }
+    pub(super) fn require_namespace(&self, at: GenerationRef, namespace: &NamespaceConfig) -> Result<(), StorageError> {
+        self.require_at(at)?;
+        let binding = namespace.schema.as_ref().and_then(|s| s.vector_certification.as_ref());
+        if binding.is_none() || self.namespaces.get(&namespace.id.get()) != binding {
+            return Err(StorageError::RecoveryRequired("namespace vectors require explicit offline re-embedding certification".into()));
+        }
+        Ok(())
+    }
+}
+impl MetadataStore {
+    pub(super) fn initialize_vector_validation(&self) -> Result<(), StorageError> {
+        // Constructor preflight already validated canonical history and payloads
+        // under stable engine ownership. Capture its exact live canonical G.
+        let read = self.db.begin_read()?;
+        let state = control::validate_existing(&read)?.ok_or_else(|| StorageError::InvalidControl("native control missing".into()))?;
+        let summary = crate::storage::vector_certification::validate_current(&read, &state)?;
+        let schema = crate::storage::canonical_schema::read_state(&read, &state)?
+            .ok_or_else(|| StorageError::InvalidControl("native schema missing".into()))?;
+        *self.vector_validation.write().map_err(|_| StorageError::RecoveryRequired("vector validation poisoned".into()))? =
+            Some(OwnedVectorValidation { at: state.generation_ref(), schema, namespaces: summary.selected });
+        Ok(())
+    }
+
+    /// Full validation belongs to owned reopen. An exact-G reader checks the
+    /// immutable schema singleton in its own transaction, without history scans.
+    pub(super) fn owned_schema_at(&self, read: &redb::ReadTransaction, at: GenerationRef)
+        -> Result<crate::storage::canonical_schema::CanonicalSchemaState, StorageError>
+    {
+        let owned = self.vector_validation.read().map_err(|_| StorageError::RecoveryRequired("vector validation poisoned".into()))?;
+        let owned = owned.as_ref().ok_or_else(|| StorageError::RecoveryRequired("owned vector validation missing".into()))?;
+        owned.require_at(at)?;
+        let table = read.open_table(crate::storage::canonical_schema::SCHEMA)?;
+        let value = table.get("state")?.ok_or_else(|| StorageError::InvalidControl("native schema missing".into()))?;
+        let schema: crate::storage::canonical_schema::CanonicalSchemaState = control::decode(value.value())?;
+        if table.len()? != 1 || schema != owned.schema {
+            return Err(StorageError::RecoveryRequired("owned native schema changed".into()));
+        }
+        Ok(schema)
+    }
+
+    pub(super) fn require_vector_validation_at(&self, at: GenerationRef) -> Result<(), StorageError> {
+        self.vector_validation.read().map_err(|_| StorageError::RecoveryRequired("vector validation poisoned".into()))?
+            .as_ref().ok_or_else(|| StorageError::RecoveryRequired("owned vector validation missing".into()))?.require_at(at)
+    }
+    pub(super) fn require_certified_namespace(&self, at: GenerationRef, namespace: &NamespaceConfig) -> Result<(), StorageError> {
+        self.vector_validation.read().map_err(|_| StorageError::RecoveryRequired("vector validation poisoned".into()))?
+            .as_ref().ok_or_else(|| StorageError::RecoveryRequired("owned vector validation missing".into()))?
+            .require_namespace(at, namespace)
+    }
+
+    pub(super) fn prepare_vector_validation_commit(&self, tx: &redb::WriteTransaction, receipt: &WriteReceipt)
+        -> Result<Option<VectorValidationCommit>, StorageError>
+    {
+        if !self.native_lifecycle_only { return Ok(None); }
+        let owned = self.vector_validation.read().map_err(|_| StorageError::RecoveryRequired("vector validation poisoned".into()))?;
+        let owned = owned.as_ref().ok_or_else(|| StorageError::RecoveryRequired("owned vector validation missing".into()))?;
+        let state = control::read_control(tx)?;
+        if state.store_id != receipt.store_id || state.committed_generation != receipt.committed_generation
+            || owned.at.store_id != state.store_id || owned.at.generation.next()? != state.committed_generation
+        { return Err(StorageError::RecoveryRequired("unparticipating canonical writer or stale vector validation".into())); }
+        let mut created = None;
+        match &receipt.outcome {
+            MutationOutcome::NativeNamespaceCreated { transition } => {
+                transition.validate(receipt)?;
+                let binding = transition.vector_certification.as_ref().ok_or_else(|| StorageError::InvalidControl("fresh namespace lacks empty-vector certification".into()))?;
+                if owned.namespaces.contains_key(&transition.namespace_id.get()) {
+                    return Err(StorageError::InvalidControl("certified namespace identity reused".into()));
+                }
+                created = Some((transition.namespace_id.get(), binding.clone()));
+            }
+            MutationOutcome::NativeMemoryInserted { transition } => {
+                transition.validate(receipt, true)?;
+                let expected = owned.namespaces.get(&transition.namespace_id.get());
+                if expected.is_none() || transition.vector_execution.as_ref().map(|e| &e.certification) != expected {
+                    return Err(StorageError::RecoveryRequired("fresh vector lacks owned certification/execution proof".into()));
+                }
+            }
+            MutationOutcome::NativeMemoryInsertedWithLinks { transition } => {
+                transition.validate(receipt)?;
+                let expected = owned.namespaces.get(&transition.namespace_id.get());
+                if expected.is_none() || transition.vector_execution.as_ref().map(|e| &e.certification) != expected {
+                    return Err(StorageError::RecoveryRequired("fresh linked vector lacks owned certification/execution proof".into()));
+                }
+            }
+            // These existing typed writers preserve vectors or remove exact
+            // owned references. Their transaction/ledger validators remain in
+            // force; carrying this validation position is not a readiness ack.
+            MutationOutcome::NativeNamespacePurgeStarted { .. }
+            | MutationOutcome::NativeNamespacePurgeAdvanced { .. }
+            | MutationOutcome::NativeNamespacePolicyUpdated { .. }
+            | MutationOutcome::NativeNamespacePolicyUnchanged { .. }
+            | MutationOutcome::InheritedDecayAdopted { .. }
+            | MutationOutcome::NativePhaseMaterialized { .. }
+            | MutationOutcome::NativeMemoryHardDeleted { .. }
+            | MutationOutcome::NativeMemoryTombstoned { .. }
+            | MutationOutcome::NativeGraphChanged { .. }
+            | MutationOutcome::NativeGraphUnchanged { .. }
+            | MutationOutcome::LifecycleFeedbackApplied { .. }
+            | MutationOutcome::LifecycleExposureRecorded { .. }
+            | MutationOutcome::BatchReserved { .. }
+            | MutationOutcome::BatchItemRejected { .. } => {}
+            _ => return Err(StorageError::RecoveryRequired("native writer has no vector-certification transition consumer".into())),
+        }
+        Ok(Some(VectorValidationCommit { before: owned.at, after: state.generation_ref(), created }))
+    }
+
+    pub(super) fn publish_vector_validation_commit(&self, pending: Option<VectorValidationCommit>, receipt: &WriteReceipt)
+        -> Result<(), StorageError>
+    {
+        let Some(pending) = pending else { return Ok(()); };
+        let result = (|| {
+            let mut owned = self.vector_validation.write().map_err(|_| StorageError::RecoveryRequired("vector validation poisoned".into()))?;
+            let owned = owned.as_mut().ok_or_else(|| StorageError::RecoveryRequired("owned vector validation missing".into()))?;
+            owned.require_at(pending.before)?;
+            if let Some((namespace, certification)) = pending.created { owned.namespaces.insert(namespace, certification); }
+            owned.at = pending.after;
+            Ok(())
+        })();
+        result.map_err(|source| {
+            self.mark_unavailable();
+            StorageError::CommittedMutation { receipt: Box::new(receipt.clone()), source: Box::new(source) }
+        })
+    }
+}
