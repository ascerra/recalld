+            after
+                .schema
+                .as_ref()
+                .unwrap()
+                .lifecycle
+                .lifecycle_updated_at,
+            now
+        );
+        assert_eq!(c.calls.load(Ordering::SeqCst), calls);
+        immutable_lifecycle(&before, &after);
+        drop(s);
+        inspect_schema(&d.path).unwrap();
+    }
