+                .as_ref()
+                .unwrap()
+                .lifecycle
+                .record_generation,
+            before.schema.as_ref().unwrap().lifecycle.record_generation
+        );
+        c.set(20_000 * DAY);
+        let calls = c.calls.load(Ordering::SeqCst);
+        committed(s.apply_decay(&ctx(&s, &d, "maintain"), &intent).unwrap());
+        let after = record(&s, id);
