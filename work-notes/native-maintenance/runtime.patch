+fn native_maintenance_rechecks_canonical_donors_and_fan_with_original_clock_for_phase_and_strength_only()
+ {
+    for days in [2.0, 4.5] {
+        let root = tempfile::tempdir().unwrap();
+        let d = fixture(root.path());
